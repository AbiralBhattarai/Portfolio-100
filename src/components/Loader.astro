---
// Loading screen with a small endless-runner game. Everything is inline so it
// works before the page's own CSS and JS arrive. Shown only while the page loads.
---
<style is:inline>
  #loader {
    --l-bg: #ffffff; --l-ink: #111113; --l-ink2: #5d5d66; --l-line: #e2e2e8; --l-accent: #2b3bff;
    position: fixed; inset: 0; z-index: 100;
    display: grid; grid-template-rows: auto 1fr auto;
    background: var(--l-bg); color: var(--l-ink);
    font-family: "Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  :root[data-theme="dark"] #loader { --l-bg: #131316; --l-ink: #f4f4f6; --l-ink2: #a1a1aa; --l-line: #2c2c33; --l-accent: #8f98ff; }
  .no-js #loader { display: none; }
  #loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
  #loader .l-in { opacity: 0; animation: l-show 0.4s 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes l-show { to { opacity: 1; } }
  #loader .l-top { padding: 1.1rem clamp(1.25rem, 4vw, 3.5rem); font-weight: 750; letter-spacing: -0.02em; }
  #loader .l-mid { display: grid; place-items: center; align-content: center; gap: 1.5rem; padding: 0 clamp(1rem, 4vw, 3rem); }
  #loader .l-status { display: flex; align-items: center; gap: 0.9rem; min-height: 2.75rem; font-size: 1.0625rem; font-weight: 600; color: var(--l-ink2); }
  #loader .l-bar { width: 7rem; height: 3px; border-radius: 99px; background: var(--l-line); overflow: hidden; position: relative; }
  #loader .l-bar::after { content: ""; position: absolute; inset: 0; width: 40%; border-radius: inherit; background: var(--l-accent); animation: l-slide 1.1s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  @keyframes l-slide { from { transform: translateX(-100%); } to { transform: translateX(260%); } }
  #loader.ready .l-bar { display: none; }
  #loader .l-go {
    display: none; align-items: center; gap: 0.45rem; height: 2.75rem; padding: 0 1.3rem; border-radius: 999px;
    border: 0; background: var(--l-ink); color: var(--l-bg); font: inherit; font-weight: 600; cursor: pointer;
  }
  #loader.ready .l-go { display: inline-flex; }
  #loader .l-go:focus-visible { outline: 2px solid var(--l-accent); outline-offset: 3px; }
  #loader canvas { display: block; width: min(56rem, 100%); height: 13.75rem; touch-action: manipulation; cursor: pointer; }
  #loader .l-hint {
    padding: 1.1rem clamp(1.25rem, 4vw, 3.5rem);
    font-size: 0.8125rem; color: var(--l-ink2); opacity: 0.55;
  }
  #loader.playing .l-hint { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    #loader, #loader .l-in { transition: none; animation: none; opacity: 1; }
    #loader .l-bar::after { animation-duration: 3s; }
  }
</style>

<div id="loader" role="dialog" aria-modal="true" aria-label="Loading">
  <div class="l-top l-in">Abiral Bhattarai</div>
  <div class="l-mid l-in">
    <div class="l-status" aria-live="polite">
      <span class="l-text">Loading</span><span class="l-bar" aria-hidden="true"></span>
      <button class="l-go" type="button">Enter site</button>
    </div>
    <canvas aria-label="A small running game. Tap or press Enter to jump."></canvas>
  </div>
  <div class="l-hint l-in">Tap or press Enter to play</div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('loader');
    if (!el) return;
    if (root.classList.contains('still')) { el.remove(); return; }
    root.classList.add('loading');
    var prevOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    var canvas = el.querySelector('canvas');
    var ctx = canvas.getContext('2d');
    var textEl = el.querySelector('.l-text');
    var goBtn = el.querySelector('.l-go');
    var W = 0, H = 0, dpr = 1, ground = 0;
    var raf = 0, last = 0, done = false, ready = false;
    var best = 0;
    try { best = +localStorage.getItem('runner-best') || 0; } catch (e) {}

    // Game state
    var P = { x: 56, y: 0, w: 30, h: 42, vy: 0, onGround: true };
    var obs = [], speed = 0, dist = 0, spawnIn = 0, state = 'idle', t = 0, dashes = 0;
    var G = 0.0026, JUMP = -0.86;

    function colors() {
      var cs = getComputedStyle(el);
      return { ink: cs.getPropertyValue('--l-ink').trim(), ink2: cs.getPropertyValue('--l-ink2').trim(), line: cs.getPropertyValue('--l-line').trim(), accent: cs.getPropertyValue('--l-accent').trim() };
    }
    var C = colors();

    function size() {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      var r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ground = H - 34;
      if (P.onGround) P.y = ground - P.h;
    }

    function reset() {
      obs = []; speed = 0.36; dist = 0; spawnIn = 700; P.vy = 0; P.onGround = true; P.y = ground - P.h;
    }

    function act() {
      if (done) return;
      if (state === 'idle' || state === 'over') {
        reset(); state = 'run'; el.classList.add('playing');
        jump(); return;
      }
      jump();
    }
    function jump() { if (P.onGround) { P.vy = JUMP; P.onGround = false; } }

    function spawn() {
      var flying = dist > 2600 && Math.random() < 0.3;
      if (flying) {
        var hy = Math.random() < 0.5 ? ground - 62 : ground - 34;
        obs.push({ k: 'drone', x: W + 20, y: hy, w: 34, h: 16, ph: Math.random() * 6 });
      } else {
        var n = 1 + Math.floor(Math.random() * (dist > 1500 ? 3 : 2));
        var stack = [];
        for (var i = 0; i < n; i++) stack.push(16 + Math.floor(Math.random() * 3) * 10);
        var w = 14 + Math.floor(Math.random() * 2) * 8;
        var h = stack.reduce(function (a, b) { return a + b; }, 0) * 0.5 + 12;
        obs.push({ k: 'tokens', x: W + 20, y: ground - h, w: w * (Math.random() < 0.35 ? 2 : 1), h: h, cells: stack.length });
      }
      var gap = (1100 + Math.random() * 900) * (0.36 / speed) ;
      spawnIn = Math.max(520, gap);
    }

    function hit(o) {
      var px = P.x + 6, py = P.y + 4, pw = P.w - 12, ph = P.h - 6;
      return px < o.x + o.w - 3 && px + pw > o.x + 3 && py < o.y + o.h - 2 && py + ph > o.y + 2;
    }

    function update(dt) {
      t += dt;
      if (state !== 'run') return;
      speed = Math.min(0.95, speed + dt * 0.000012);
      dist += speed * dt;
      dashes = (dashes + speed * dt) % 40;
      P.vy += G * dt; P.y += P.vy * dt;
      if (P.y >= ground - P.h) { P.y = ground - P.h; P.vy = 0; P.onGround = true; }
      spawnIn -= dt * (speed / 0.36);
      if (spawnIn <= 0) spawn();
      for (var i = obs.length - 1; i >= 0; i--) {
        var o = obs[i]; o.x -= speed * dt;
        if (o.x + o.w < -20) obs.splice(i, 1);
        else if (hit(o)) { state = 'over'; var s = Math.floor(dist / 10); if (s > best) { best = s; try { localStorage.setItem('runner-best', String(best)); } catch (e) {} } }
      }
    }

    function rr(x, y, w, h, r) { ctx.beginPath(); ctx.roundRect ? ctx.roundRect(x, y, w, h, r) : ctx.rect(x, y, w, h); }

    function drawBot() {
      var x = P.x, y = P.y, run = state === 'run' && P.onGround;
      var f = run ? Math.floor(t / 90) % 2 : 0;
      ctx.fillStyle = C.ink;
      // antenna
      ctx.fillRect(x + 14, y, 2, 6);
      ctx.beginPath(); ctx.arc(x + 15, y, 2.6, 0, Math.PI * 2); ctx.fill();
      // head
      rr(x + 4, y + 5, 22, 16, 6); ctx.fill();
      // visor
      ctx.fillStyle = C.accent; rr(x + 9, y + 10, 14, 5, 2.5); ctx.fill();
      ctx.fillStyle = C.ink;
      // body
      rr(x + 7, y + 22, 16, 12, 4); ctx.fill();
      // arms
      var a = run ? (f ? 2 : -2) : 0;
      ctx.fillRect(x + 3, y + 24 + a, 4, 8);
      ctx.fillRect(x + 23, y + 24 - a, 4, 8);
      // legs
      if (!P.onGround) { ctx.fillRect(x + 9, y + 34, 4, 6); ctx.fillRect(x + 17, y + 34, 4, 6); }
      else if (f) { ctx.fillRect(x + 9, y + 34, 4, 8); ctx.fillRect(x + 17, y + 34, 4, 4); }
      else { ctx.fillRect(x + 9, y + 34, 4, 4); ctx.fillRect(x + 17, y + 34, 4, 8); }
    }

    function drawObs(o) {
      ctx.fillStyle = C.ink;
      if (o.k === 'tokens') {
        var cells = o.cells, ch = o.h / cells;
        for (var i = 0; i < cells; i++) { rr(o.x, o.y + i * ch + 1, o.w, ch - 2, 3); ctx.fill(); }
      } else {
        var bob = Math.sin(t / 120 + o.ph) * 2;
        rr(o.x + 6, o.y + 5 + bob, o.w - 12, o.h - 6, 4); ctx.fill();
        var flap = Math.floor(t / 70) % 2 ? 3 : 0;
        ctx.fillRect(o.x, o.y + bob + flap, 12, 2.5);
        ctx.fillRect(o.x + o.w - 12, o.y + bob + 3 - flap, 12, 2.5);
        ctx.fillStyle = C.accent; ctx.fillRect(o.x + o.w / 2 - 2, o.y + 9 + bob, 4, 3);
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      // ground
      ctx.fillStyle = C.line; ctx.fillRect(0, ground, W, 2);
      ctx.fillStyle = C.ink2;
      for (var x = -dashes; x < W; x += 40) ctx.fillRect(x, ground + 9, 10, 1.5);
      for (var i = 0; i < obs.length; i++) drawObs(obs[i]);
      drawBot();
      ctx.font = '500 13px ui-monospace, "Fragment Mono", monospace';
      ctx.fillStyle = C.ink2; ctx.textAlign = 'right';
      if (state !== 'idle') ctx.fillText((best ? 'BEST ' + String(best).padStart(5, '0') + '   ' : '') + String(Math.floor(dist / 10)).padStart(5, '0'), W - 4, 18);
      if (state === 'over') {
        ctx.textAlign = 'center'; ctx.fillStyle = C.ink;
        ctx.font = '700 18px "Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif';
        ctx.fillText('Out of tokens.', W / 2, H / 2 - 18);
        ctx.font = '500 13px "Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif';
        ctx.fillStyle = C.ink2; ctx.fillText('Tap or press Enter to run again', W / 2, H / 2 + 4);
      }
    }

    function loop(now) {
      var dt = Math.min(40, now - (last || now)); last = now;
      update(dt); draw();
      if (!done) raf = requestAnimationFrame(loop);
    }

    function onKey(e) {
      if (done) return;
      if (e.key === 'Escape' && ready) { e.preventDefault(); dismiss(); return; }
      if (e.target === goBtn) return;
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowUp') { e.preventDefault(); act(); }
    }
    function onTap(e) { if (e.target === goBtn) return; e.preventDefault(); act(); }

    function dismiss() {
      if (done) return;
      done = true; cancelAnimationFrame(raf);
      document.removeEventListener('keydown', onKey);
      el.classList.add('out');
      root.classList.remove('loading');
      document.body.style.overflow = prevOverflow;
      setTimeout(function () { el.remove(); }, 400);
    }

    function markReady() {
      if (ready || done) return;
      ready = true;
      if (state !== 'run') { dismiss(); return; }
      el.classList.add('ready');
      textEl.textContent = 'Site ready';
      goBtn.focus({ preventScroll: true });
    }

    size(); reset();
    window.addEventListener('resize', size);
    document.addEventListener('keydown', onKey);
    el.addEventListener('pointerdown', onTap);
    goBtn.addEventListener('click', dismiss);
    new MutationObserver(function () { C = colors(); }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    raf = requestAnimationFrame(loop);

    // ?loader keeps the screen up for previewing the game.
    if (!/[?&]loader(=|&|$)/.test(location.search)) {
      if (document.readyState === 'complete') markReady();
      else window.addEventListener('load', markReady);
      setTimeout(markReady, 12000);
    }
  })();
</script>
