---
import '../styles/global.css';
import '../styles/sectra.css';
import Loader from '../components/Loader.astro';
import { EMAIL, CV, GITHUB, LINKEDIN, SITE, to, ghIcon, inIcon, wave } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  /** [label, href, section ids it covers] */
  links: [string, string, string][];
  /** Where the wordmark goes: the page top on the home page, the home page elsewhere. */
  home?: string;
  loader?: boolean;
}
const { title, description, path, links, home = '#top', loader = false } = Astro.props;
const url = SITE + path;

// Nav timeline: the whole page as one long waveform.
const TLN = 220;
const tlBars = wave(TLN, [[0, 219]], 11)
  .map((b, i) => { const h = (1.5 + b.h * 6.5).toFixed(2); return `<rect x="${i + 0.18}" y="${(8 - +h).toFixed(2)}" width="0.64" height="${h}" />`; })
  .join('');
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={url} />
    <slot name="head" />
    <link rel="icon" href={to('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={to('/fonts/schibsted-grotesk-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') t = q;
        if (new URLSearchParams(location.search).has('still')) d.classList.add('still');
        if (t !== 'light' && t !== 'dark') t = 'light';
        d.setAttribute('data-theme', t);
        var c = t === 'dark' ? '#08080a' : '#ffffff';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', c); m.removeAttribute('media'); });
      })();
    </script>
  </head>
  <body>
    {loader && <Loader />}
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href={home}>
          <svg class="brand-mark" viewBox="0 0 22 16" aria-hidden="true">
            <rect x="0" y="6" width="3" height="4" rx="1.5" style="--k:0.9" />
            <rect class="c" x="4.75" y="2" width="3" height="12" rx="1.5" style="--k:-0.4" />
            <rect class="c" x="9.5" y="0" width="3" height="16" rx="1.5" style="--k:0.25" />
            <rect class="c" x="14.25" y="3.5" width="3" height="9" rx="1.5" style="--k:-0.45" />
            <rect x="19" y="6.5" width="3" height="3" rx="1.5" style="--k:1.1" />
          </svg>
          Abiral Bhattarai
        </a>
        <span class="nav-tc" aria-hidden="true">
          <i class="tc-dot"></i><b class="tc-rec">REC</b><span class="tc-clip">CLIP 01</span><span class="tc-name">Intro</span><span class="tc-time">00:00</span>
        </span>
        <nav class="nav-links" aria-label="Sections">
          <span class="nav-pill" aria-hidden="true"></span>
          {links.map(([label, href, ids]) => <a href={href} data-for={ids}>{label}</a>)}
        </nav>
        <div class="nav-ext">
          <a href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub"><Fragment set:html={ghIcon} /></a>
          <a href={LINKEDIN} target="_blank" rel="noopener" aria-label="LinkedIn"><Fragment set:html={inIcon} /></a>
        </div>
        <a class="nav-cv" href={CV} target="_blank" rel="noopener">Resume</a>
        <button class="theme" type="button" aria-label="Switch to dark mode" data-theme-toggle>
          <svg class="sun" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="moon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
        <button class="nav-menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet" data-menu-open>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6.5h14M3 13.5h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
        <div class="nav-tl" aria-hidden="true">
          <svg class="tl-base" viewBox={`0 0 ${TLN} 8`} preserveAspectRatio="none"><Fragment set:html={tlBars} /></svg>
          <svg class="tl-fill" viewBox={`0 0 ${TLN} 8`} preserveAspectRatio="none"><Fragment set:html={tlBars} /></svg>
          <span class="tl-clip"></span>
        </div>
      </div>
    </header>

    <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
      <div class="sheet-top">
        <a class="brand" href={home} data-menu-link>Abiral Bhattarai</a>
        <button class="theme" type="button" aria-label="Close menu" data-menu-close>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <nav class="sheet-links" aria-label="Sections">
        {links.map(([label, href], i) => <a href={href} data-menu-link><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}
      </nav>
      <div class="sheet-foot">
        <div class="sheet-ext">
          <a class="pill pill-ink" href={CV} target="_blank" rel="noopener">Resume</a>
          <a href={`mailto:${EMAIL}`} data-mail aria-haspopup="menu">Email</a>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>

    <div class="mailpick" id="mailpick" role="menu" aria-label="Email Abiral with" hidden>
      <p class="mailpick-to">{EMAIL}</p>
      <a role="menuitem" href={`https://mail.google.com/mail/?view=cm&fs=1&to=${EMAIL}`} target="_blank" rel="noopener">Gmail</a>
      <a role="menuitem" href={`https://outlook.live.com/mail/0/deeplink/compose?to=${EMAIL}`} target="_blank" rel="noopener">Outlook.com</a>
      <a role="menuitem" href={`https://compose.mail.yahoo.com/?to=${EMAIL}`} target="_blank" rel="noopener">Yahoo Mail</a>
      <a role="menuitem" href={`mailto:${EMAIL}`}>Your mail app</a>
      <button role="menuitem" type="button" data-copy={EMAIL}>Copy address</button>
    </div>

    <main id="main">
      <slot />
    </main>

    <button class="jump" type="button" data-jump aria-label="Go to next section">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3.5v13M4.5 11 10 16.5 15.5 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
