---
import '../styles/global.css';
import { to } from '../lib/site';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Abiral Bhattarai</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={to('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <main class="nf wrap">
      <p class="nf-code">404 · 00:00 – 00:00</p>
      <h1 class="display nf-title">This clip<br />got cut.</h1>
      <svg class="nf-wave" viewBox="0 0 600 60" aria-hidden="true">
        {Array.from({ length: 50 }, (_, i) => <rect x={i * 12 + 2} y="27" width="8" height="6" rx="3" />)}
      </svg>
      <p class="lede">The page you're after isn't here. It may have moved, or the link has a typo.</p>
      <div class="actions">
        <a class="pill pill-solid" href={to('/')}>Back to the portfolio</a>
        <a class="pill pill-ink" href={to('/sectra/')}>See Sectra</a>
      </div>
    </main>
  </body>
</html>

<style>
  .nf { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 2rem; padding-block: 4rem; }
  .nf-code { font-family: var(--mono); font-size: 0.875rem; color: var(--accent-ink); }
  .nf-title { font-size: clamp(4rem, 13vw, 10rem); }
  .nf-wave { width: min(100%, 36rem); height: auto; }
  .nf-wave rect { fill: color-mix(in srgb, var(--ink) 22%, transparent); }
</style>
