    <button class="jump" type="button" data-jump aria-label="Go to next section">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3.5v13M4.5 11 10 16.5 15.5 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <script>
      // Theme toggle
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const label = () => {
        if (!btn) return;
        const dark = root.getAttribute('data-theme') === 'dark';
        btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      };
      label();
      btn?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', next === 'dark' ? '#131316' : '#ffffff'));
        label();
      });

      // Next-section / back-to-top button
      const jump = document.querySelector<HTMLButtonElement>('[data-jump]');
      const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section'));
      const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8;
      const syncJump = () => {
        if (!jump) return;
        const up = atBottom();
        jump.classList.toggle('up', up);
        const jr = jump.getBoundingClientRect();
        const probe = jr.top + jr.height / 2;
        const under = sections.find((el) => { const b = el.getBoundingClientRect(); return b.top <= probe && b.bottom > probe; });
        const tone = under?.dataset.tone || 'ink';
        if (jump.dataset.tone !== tone) jump.dataset.tone = tone;
        jump.setAttribute('aria-label', up ? 'Back to top' : 'Go to next section');
      };
      const reduceJump = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let anim = 0;
      const glide = (to: number) => {
        cancelAnimationFrame(anim);
        const from = window.scrollY;
        const dist = to - from;
        if (reduceJump || Math.abs(dist) < 2) { window.scrollTo({ top: to, behavior: 'instant' as ScrollBehavior }); return; }
        const dur = Math.min(700, 280 + Math.abs(dist) * 0.08);
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / dur);
          const e = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
          window.scrollTo({ top: from + dist * e, behavior: 'instant' as ScrollBehavior });
          if (t < 1) anim = requestAnimationFrame(step);
        };
        anim = requestAnimationFrame(step);
      };
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { syncJump(); ticking = false; });
      };
      if (jump) {
        syncJump();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        ['wheel', 'touchstart', 'keydown'].forEach((ev) => window.addEventListener(ev, () => cancelAnimationFrame(anim), { passive: true }));
        jump.addEventListener('click', () => {
          if (atBottom()) { glide(0); return; }
          const offset = 72;
          const next = sections.find((el) => el.getBoundingClientRect().top > offset + 8);
          const max = document.documentElement.scrollHeight - window.innerHeight;
          glide(next ? Math.min(max, next.getBoundingClientRect().top + window.scrollY - offset) : max);
        });
      }

      // Sectra scroll stepper
      const stage = document.querySelector<HTMLElement>('.stage');
      const stepEls = Array.from(document.querySelectorAll<HTMLElement>('.step'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (stage && stepEls.length && 'IntersectionObserver' in window) {
        const set = (n: string) => {
          stage.dataset.step = n;
          stepEls.forEach((el) => el.classList.toggle('on', el.dataset.step === n));
        };
        set(reduce || root.classList.contains('still') ? '6' : '1');
        if (reduce) stepEls.forEach((el) => el.classList.add('on'));
        else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) set((e.target as HTMLElement).dataset.step || '1');
              });
            },
            { rootMargin: '-45% 0px -45% 0px' }
          );
          stepEls.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
