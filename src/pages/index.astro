const AGENT = 'https://github.com/AbiralBhattarai/marketing_agent';
const PAPER = 'https://doi.org/10.3126/jacem.v11i1.84250';

// Deterministic waveform: speech regions are loud and textured, gaps are low.
function wave(n: number, speech: [number, number][], seed: number) {
  let s = seed;
  const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
  return Array.from({ length: n }, (_, i) => {
    const inSpeech = speech.some(([a, b]) => i >= a && i <= b);
    const base = inSpeech
      ? 0.35 + 0.45 * Math.abs(Math.sin(i * 0.37)) * (0.6 + 0.4 * rnd()) + 0.2 * rnd()
      : 0.05 + 0.08 * rnd();
    return { h: Math.min(1, base), sp: inSpeech };
  });
}

// Hero waveform
const HN = 150;
const heroSpeech: [number, number][] = [[6, 38], [50, 104], [114, 144]];
const heroClip: [number, number] = [50, 104];
const hero = wave(HN, heroSpeech, 7);
const HW = 1200, HH = 210, HBW = HW / HN;
const heroWords = ['the', 'model', 'is', 'only', 'half', 'of', 'the', 'product.'];
const MN = 56;
const mSpeech: [number, number][] = [[2, 14], [20, 44], [49, 54]];
const mClip: [number, number] = [20, 44];
const mob = wave(MN, mSpeech, 7);
const MW = 400, MH = 120, MBW = MW / MN;

// Sectra stage waveform
const SN = 90;
const stSpeech: [number, number][] = [[4, 22], [30, 62], [70, 86]];
const stClip: [number, number] = [30, 62];
const st = wave(SN, stSpeech, 42);
const SW = 600, SH = 190, SBW = SW / SN;

const stWords = [
  ['so', '00:41.8'], ['the', '00:42.0'], ['model', '00:42.2'], ['is', '00:42.7'],
  ['only', '00:42.9'], ['half', '00:43.3'], ['of', '00:43.7'], ['the', '00:43.8'],
  ['product', '00:44.0'], ['and', '00:44.9'], ['the', '00:45.1'], ['rest', '00:45.3'],
];
const hlWords = new Set([1, 2, 3, 4, 5, 6, 7, 8]);

const steps = [
  { t: 'Paste a link.', p: 'Drop in a YouTube URL or a local file. Sectra pulls it in and caps it at 1080p.', tech: 'yt-dlp · ffmpeg' },
  { t: 'Find the speech.', p: 'Voice activity detection marks where people talk, so only speech gets transcribed.', tech: 'Silero VAD' },
  { t: 'Hear every word.', p: 'Speech becomes text with a timestamp on every single word.', tech: 'faster-whisper' },
  { t: 'Pick the moments.', p: 'An LLM reads the transcript and proposes clips. Sectra snaps them to sentences and keeps them 15 to 60 seconds.', tech: 'Ollama, or any OpenAI-compatible or Anthropic API' },
  { t: 'Edit and export.', p: 'Trim, crop, and restyle captions in the browser. Export a captioned MP4 in 9:16, 1:1 or 16:9.', tech: 'React editor · ffmpeg + libass' },
  { t: 'Post everywhere.', p: 'One click on a clip, and a headless browser uploads it to X, TikTok, YouTube and Instagram.', tech: 'Playwright poster' },
];
const platforms = ['X', 'TikTok', 'YouTube', 'Instagram'];
const stageNames = ['Ingest', 'Speech', 'Transcribe', 'Clips', 'Export', 'Post'];

const sectraSpecs = [
  ['Runs on', 'Your machine, in Docker'],
  ['Language model', 'Local through Ollama, or a cloud API'],
  ['Speech to text', 'faster-whisper, or a cloud API'],
  ['Speech detection', 'Silero VAD'],
  ['Output', '1080p H.264 MP4 with burned-in captions, plus SRT'],
  ['Auto-post', 'X, TikTok, YouTube and Instagram, through a headless browser'],
  ['Concurrency', 'An async worker on Redis Streams, with its own limit for downloads, ffmpeg, VAD, speech-to-text and LLM calls'],
  ['License', 'MIT, open source'],
];

// Agent graph: a linear setup, then a ReAct loop (LLM <-> tools) that exits to the campaign.
const setup = [
  { k: 'in', t: 'Your prompt' },
  { k: 'ai', t: 'Plan the steps' },
  { k: 'human', t: 'You approve' },
  { k: 'ai', t: 'Find competitors' },
  { k: 'human', t: 'You pick sites' },
];
const toolChips = ['Web search', 'Campaign history', 'Parse to JSON'];

const focus = [
  ['Cost optimization', 'Less compute per answer: dynamic audio chunking, unique-frame analysis and bounded concurrency, with the same quality.'],
  ['Progressive tool calling', 'Agents get tools as a task needs them, not all at once, so prompts stay small and choices stay sharp.'],
  ['Context management', 'What an agent keeps, summarizes and drops as a task grows longer.'],
  ['Memory for MCP clients', 'MCP clients that remember across sessions and tools.'],
];

const work: { t: string; p: string; tags: string[]; href?: string; where?: string }[] = [
  {
    t: 'Nepanglish Whisper',
    p: 'A hackathon project: Whisper fine-tuned with QLoRA to transcribe Nepanglish, speech that mixes Nepali and English, including banking terms. I built the dataset: AI-curated scripts, then recorded the Nepali-English test audio myself.',
    tags: ['Whisper', 'QLoRA', 'Speech-to-text', 'Dataset curation'],
    where: 'Hackathon',
  },
  {
    t: 'SemanticRag',
    p: 'A chatbot that answers questions from Nepali banking documents, with a semantic cache for repeat questions.',
    tags: ['FastAPI', 'ChromaDB', 'Redis', 'Streamlit'],
    href: 'https://github.com/AbiralBhattarai/SemanticRag',
  },
  {
    t: 'Face matching',
    p: 'A custom Siamese network: two identical CNNs decide whether two faces are the same person.',
    tags: ['Siamese network', 'CNN', 'Olivetti faces'],
    href: 'https://github.com/AbiralBhattarai/Face_matching',
  },
  {
    t: 'Malicious URL detector',
    p: 'A custom LSTM that classifies URLs as malicious or benign, shipped as a Chrome extension that blocks them.',
    tags: ['LSTM', 'Chrome extension'],
    href: 'https://github.com/AbiralBhattarai/Malicious-URL-detection-Using-LSTM',
  },
  {
    t: 'Banking automation',
    p: 'RPA tasks for banks, and a RAG chatbot that answers questions from banking documents.',
    tags: ['RPA', 'RAG', 'LangChain', 'FastAPI'],
    where: 'At Quickfox',
  },
  {
    t: 'QuickStudio nodes',
    p: 'Custom nodes for QuickStudio, an n8n-style automation platform: Google Sheets and other integrations, OAuth sign-in, and automation nodes.',
    tags: ['OAuth', 'Google Sheets API', 'Workflow automation'],
    where: 'At Quickfox',
  },
];

const skills = [
  ['Agents & LLMs', 'LangGraph, LangChain, MCP, Google Gen AI SDK, OpenAI SDK'],
  ['Machine learning', 'PyTorch, Keras, Scikit-learn, SpaCy, NLTK'],
  ['Backend & APIs', 'FastAPI, Strawberry GraphQL, GraphQL Federation, gRPC, Django, Pydantic'],
  ['Data & messaging', 'PostgreSQL, Redis, Amazon S3, Apache Kafka'],
  ['Cloud & DevOps', 'Docker, Kubernetes, Argo CD, GitHub Actions'],
  ['Architecture', 'Hexagonal Architecture, Microservices, Asyncio'],
  ['Tools', 'Git, GitHub'],
  ['Languages', 'Python, C++, C, SQL'],
];

const timeline = [
  { w: 'Aug 2026 – Now', t: 'Jr. AI/ML Engineer', o: 'Veel', p: 'Building AI features that ship to real users.' },
  { w: 'May – Aug 2026', t: 'AI/ML Engineering Intern', o: 'Veel', p: 'Backend services for AI products.' },
  { w: 'Aug – Nov 2025', t: 'Software Engineer Intern', o: 'Quickfox Consulting', p: 'Custom nodes and OAuth for QuickStudio, an n8n-style automation platform. RPA tasks for banks and a banking RAG chatbot.' },
  { w: '2021 – 2025', t: 'B.E. Computer Engineering', o: 'Tribhuvan University', p: 'Final-year research on peptide binding affinity, published in JACEM.' },
];

const arrow = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const right = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const mailIcon = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.75" stroke="currentColor" stroke-width="1.5"/><path d="m2.5 4.5 5.5 4.25 5.5-4.25" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>';
const dlIcon = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 1.75h5.25L12.5 5v9.25H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 1.75V5.25h3.5M6.25 8.5h4M6.25 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';

---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abiral Bhattarai — AI × Product</title>
    <meta name="description" content="Abiral Bhattarai is an AI/ML engineer in Kathmandu who turns models and agents into products people use." />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131316" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content="Abiral Bhattarai — AI × Product" />
    <meta property="og:description" content="AI/ML engineer in Kathmandu. I turn models and agents into products people use." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') t = q;
        if (new URLSearchParams(location.search).has('still')) d.classList.add('still');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.setAttribute('data-theme', t);
        var c = t === 'dark' ? '#131316' : '#ffffff';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', c); m.removeAttribute('media'); });
      })();
    </script>
  </head>
  <body>
    <Loader />
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="#top">Abiral Bhattarai</a>
        <nav class="nav-links" aria-label="Elsewhere">
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${EMAIL}`}>Email</a>
        </nav>
        <a class="nav-cv" href={CV} target="_blank" rel="noopener">Resume</a>
        <button class="theme" type="button" aria-label="Switch to dark mode" data-theme-toggle>
          <svg class="sun" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="moon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" id="top">
        <div class="wrap">
          <h1 class="display hero-title">AI <span class="x" aria-hidden="true">×</span><span class="vh">and</span> Product.</h1>
          <div class="hero-row">
            <p class="lede">I'm <strong>Abiral Bhattarai</strong>, an AI/ML engineer in Kathmandu. I turn models and agents into products people use, like Sectra.</p>
            <div class="actions">
              <a class="pill pill-solid" href={`mailto:${EMAIL}`}><Fragment set:html={mailIcon} />Email me</a>
              <a class="pill pill-ink" href={CV} target="_blank" rel="noopener"><Fragment set:html={dlIcon} />View CV</a>
            </div>
          </div>

          <figure class="wave">
            <svg class="w-lg" viewBox={`0 -64 ${HW} ${HH + 64}`} role="img" aria-label="Illustration: a speech waveform where Sectra highlights the words 'the model is only half of the product' and marks them as a clip.">
              <rect class="bracket-fill" x={heroClip[0] * HBW - 4} y="-10" width={(heroClip[1] - heroClip[0] + 1) * HBW + 8} height={HH + 10} rx="10" />
              <path class="bracket" d={`M${heroClip[0] * HBW - 4} ${HH} V-10 h10 M${heroClip[0] * HBW - 4} ${HH} h10 M${(heroClip[1] + 1) * HBW + 4} ${HH} V-10 h-10 M${(heroClip[1] + 1) * HBW + 4} ${HH} h-10`} />
              <text class="tlabel" x={heroClip[0] * HBW + 10} y="-46">CLIP 01 · 00:42 – 01:18</text>
              {heroWords.map((w, i) => {
                const lens = heroWords.map((t) => t.length + 1.6);
                const total = lens.reduce((a, c) => a + c, 0);
                const startX = (heroClip[0] + 1.5) * HBW;
                const width = (heroClip[1] - heroClip[0] - 1) * HBW;
                const before = lens.slice(0, i).reduce((a, c) => a + c, 0);
                const x = startX + (before / total) * width;
                return <text class="word" style={`--w:${i}`} x={x} y="-20">{w}</text>;
              })}
              {hero.map((b, i) => {
                const h = Math.max(4, b.h * (HH - 20));
                const inClip = i >= heroClip[0] && i <= heroClip[1];
                return <rect class={`bar${b.sp ? ' sp' : ''}${inClip ? ' clip' : ''}`} style={`--i:${i}`} x={i * HBW + 1.5} y={HH - h} width={HBW - 3} height={h} rx={(HBW - 3) / 2} />;
              })}
            </svg>
            <svg class="w-sm" viewBox={`0 -40 ${MW} ${MH + 40}`} role="img" aria-label="Illustration: a speech waveform where Sectra marks one passage as a clip.">
              <rect class="bracket-fill" x={mClip[0] * MBW - 3} y="-6" width={(mClip[1] - mClip[0] + 1) * MBW + 6} height={MH + 6} rx="8" />
              <text class="tlabel" x={mClip[0] * MBW + 2} y="-16" style="font-size:13px">CLIP 01 · 00:42 – 01:18</text>
              {mob.map((b, i) => {
                const h = Math.max(3, b.h * (MH - 10));
                const inClip = i >= mClip[0] && i <= mClip[1];
                return <rect class={`bar${b.sp ? ' sp' : ''}${inClip ? ' clip' : ''}`} style={`--i:${i}`} x={i * MBW + 1} y={MH - h} width={MBW - 2} height={h} rx={(MBW - 2) / 2} />;
              })}
            </svg>
            <figcaption>
              <span>Sectra finding a clip in a talk. Illustration.</span>
              <a href="#sectra">See how it works</a>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- Sectra -->
      <section class="sectra" id="sectra" data-tone="stage" aria-labelledby="sectra-title">
        <div class="wrap">
          <div class="sectra-head">
            <h2 class="display sectra-title" id="sectra-title">Sectra<span>.</span></h2>
            <p class="sub">Long videos in. Captioned clips out. Everything runs on your own machine.</p>
            <div class="sectra-meta">
              <a class="pill pill-line" href={SECTRA} target="_blank" rel="noopener">View on GitHub <Fragment set:html={arrow} /></a>
              <span class="body">My open-source clipping and narration tool. Local LLM, local speech-to-text, no upload required.</span>
            </div>
          </div>

          <div class="scrolly">
            <ol class="steps">
              {steps.map((s, i) => (
                <li class="step" data-step={i + 1}>
                  <h3>{s.t}</h3>
                  <p>{s.p}</p>
                  <span class="tech">{s.tech}</span>
                </li>
              ))}
            </ol>

            <div class="stage-wrap">
              <div class="stage" data-step="6" aria-hidden="true">
                <div class="st-bar">
                  <span class="url">youtube.com/watch?v=… · 58:12 talk</span>
                  <span class="go">Find clips</span>
                </div>
                <ul class="st-stages">
                  {stageNames.map((n) => <li>{n}</li>)}
                </ul>
                <div class="st-body">
                  <div class="st-main">
                    <div class="st-wave">
                      <svg viewBox={`0 -26 ${SW} ${SH + 26}`}>
                        <rect class="clipbox" x={stClip[0] * SBW - 3} y="-6" width={(stClip[1] - stClip[0] + 1) * SBW + 6} height={SH + 6} rx="8" />
                        <text class="cliplabel" x={stClip[0] * SBW + 4} y="-12">CLIP 01 · 36s</text>
                        {st.map((b, i) => {
                          const h = Math.max(3, b.h * (SH - 12));
                          const inClip = i >= stClip[0] && i <= stClip[1];
                          return <rect class={`bar${b.sp ? ' sp' : ''}${inClip ? ' cl' : ''}`} x={i * SBW + 1} y={SH - h} width={SBW - 2} height={h} rx={(SBW - 2) / 2} />;
                        })}
                      </svg>
                    </div>
                    <div class="st-words">
                      {stWords.map(([w, ts], i) => (
                        <span class={hlWords.has(i) ? 'hl' : ''} style={`--w:${i}`}>{w}<small>{ts}</small></span>
                      ))}
                    </div>
                    <ul class="st-post">
                      {platforms.map((n) => <li><span class="dot"></span>{n}</li>)}
                    </ul>
                    <p class="st-note">Illustration with sample data.</p>
                  </div>
                  <div class="phone">
                    <span class="ratio">9:16</span>
                    <svg class="person" viewBox="0 0 100 110"><circle cx="50" cy="34" r="20" fill="#3b3f4a"/><path d="M8 110c4-30 22-46 42-46s38 16 42 46z" fill="#2c303a"/></svg>
                    <p class="cap">The model is only <b>half</b> of the product</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="wrap specs">
          <h3>Sectra at a glance.</h3>
          <dl class="spec-grid">
            {sectraSpecs.map(([k, v]) => (
              <div><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </div>
      </section>

      <!-- AI x product research -->
      <section class="section" id="focus" aria-labelledby="focus-title">
        <div class="wrap">
          <div class="section-head">
            <h2 class="h2" id="focus-title">AI <span class="x">×</span> product research.</h2>
            <p class="sub">The questions I work on: how to make AI cheap, reliable and useful enough to ship.</p>
          </div>
          <ul class="focus">
            {focus.map(([t, p]) => (
              <li class="fr"><h3>{t}</h3><p>{p}</p></li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Marketing agent -->
      <section class="section panel" id="agent" data-tone="accent" aria-labelledby="agent-title">
        <div class="wrap">
          <div class="section-head">
            <h2 class="h2" id="agent-title">An agent that asks before it acts.</h2>
            <p class="sub">My open-source marketing agent turns one prompt into a full campaign, and stops twice for your say.</p>
          </div>
          <figure class="graph-wrap">
            <svg class="graph g-lg" viewBox="0 -30 1200 720" role="img" aria-labelledby="g-desc">
              <desc id="g-desc">The agent's graph. Your prompt leads to planning the steps, which you approve or reject to re-plan. It then finds competitors and you pick which sites to study. Next comes a loop: the LLM calls tools (web search, campaign history, parsing to JSON), reads the results, and repeats. When it is ready, it generates the campaign.</desc>
              <defs>
                <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="g-head" /></marker>
              </defs>
              {setup.map((n, i) => {
                const x = 30 + i * 240;
                return (
                  <g class={`g-node ${n.k}`}>
                    <rect x={x} y="52" width="180" height="56" rx="28" />
                    <text x={x + 90} y="86">{n.t}</text>
                    {i < setup.length - 1 && <path class="g-edge" d={`M${x + 184} 80 H${x + 236}`} marker-end="url(#ah)" />}
                  </g>
                );
              })}
              <path class="g-edge g-back" d="M600 50 C600 4, 360 4, 360 48" marker-end="url(#ah)" />
              <text class="g-label" x="480" y="-12">reject: re-plan</text>

              <path class="g-edge" d="M1080 110 V170 C1080 225, 690 200, 690 268" marker-end="url(#ah)" />

              <circle class="g-ring" cx="690" cy="440" r="150" />
              <text class="g-loop" x="690" y="440">ReAct loop</text>
              <text class="g-label" x="690" y="468">repeats until the plan is complete</text>

              <path class="g-edge g-cycle" d="M792 300 C940 330, 940 550, 792 580" marker-end="url(#ah)" />
              <text class="g-label ta-s" x="950" y="445">calls a tool</text>
              <path class="g-edge g-cycle" d="M588 580 C440 550, 440 330, 588 300" marker-end="url(#ah)" />
              <text class="g-label ta-e" x="430" y="445">reads results</text>

              <g class="g-node ai"><rect x="590" y="270" width="200" height="60" rx="30" /><text x="690" y="306">LLM</text></g>
              <g class="g-node tool"><rect x="590" y="550" width="200" height="60" rx="30" /><text x="690" y="586">Tools</text></g>
              {toolChips.map((c, i) => <text class="g-chip" x={530 + i * 160} y="650">{c}</text>)}

              <path class="g-edge" d="M588 290 C400 290, 150 300, 150 402" marker-end="url(#ah)" />
              <text class="g-label" x="330" y="280">when ready, generate</text>
              <g class="g-node end"><rect x="50" y="406" width="200" height="60" rx="30" /><text x="150" y="442">Campaign</text></g>
            </svg>
            <svg class="graph g-sm" viewBox="0 0 400 1010" role="img" aria-label="The agent's graph: prompt, plan, your approval, competitors, your pick of sites, then a loop where the LLM calls tools and reads results until it generates the campaign.">
              <defs>
                <marker id="ahm" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="g-head" /></marker>
              </defs>
              {setup.map((n, i) => {
                const y = 20 + i * 92;
                return (
                  <g class={`g-node ${n.k}`}>
                    <rect x="90" y={y} width="220" height="54" rx="27" />
                    <text x="200" y={y + 33}>{n.t}</text>
                    {i < setup.length - 1 && <path class="g-edge" d={`M200 ${y + 56} V${y + 90}`} marker-end="url(#ahm)" />}
                  </g>
                );
              })}
