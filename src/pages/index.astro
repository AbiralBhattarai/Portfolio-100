---
import Base from '../layouts/Base.astro';
import SectraLoop from '../components/SectraLoop.astro';
import AgentGraph from '../components/AgentGraph.astro';
import Contact from '../components/Contact.astro';
import { EMAIL, CV, GITHUB, LINKEDIN, SECTRA, AGENT, PAPER, SITE, to, wave, arrow, right, mailIcon, dlIcon } from '../lib/site';
import { projects, num } from '../lib/projects';

// Hero waveform
const HN = 150;
const heroSpeech: [number, number][] = [[6, 38], [50, 104], [114, 144]];
const heroClip: [number, number] = [50, 104];
const hero = wave(HN, heroSpeech, 7);
const HW = 1200, HH = 210, HBW = HW / HN;
const heroWords = ['the', 'model', 'is', 'only', 'half', 'of', 'the', 'product.'];
const MN = 56;
const mSpeech: [number, number][] = [[2, 14], [20, 44], [49, 54]];
const mClip: [number, number] = [20, 44];
const mob = wave(MN, mSpeech, 7);
const MW = 400, MH = 120, MBW = MW / MN;

// Sectra in four lines, beside the auto-playing card.
const overview = [
  ['Finding the moments', 'Silero VAD finds the speech, faster-whisper transcribes every word, and a local LLM through Ollama scores the transcript for moments worth clipping.'],
  ['Following the speaker', 'YuNet finds faces and Light-ASD scores who is talking, frame by frame, so each clip crops to the active speaker in 9:16, 1:1 or 16:9 with burned-in captions.'],
  ['A worker that keeps up', 'An async worker on Redis Streams runs each stage (downloads, ffmpeg, VAD, speech-to-text, the LLM) with its own concurrency limit.'],
  ['Narration and posting', 'Narrator reads stories aloud with Kokoro and a lip-synced stick figure, and Playwright posts finished clips to five platforms from your own browser.'],
];

// What the Sectra page covers beyond the clipping demo.
const sectraMore = [
  ['How clips are scored', 'Five qualities, fixed weights, then a ranking round.'],
  ['Narrator', 'Written stories in, narrated parts out.'],
  ['The editor', 'Trim, crop, captions, music, in the browser.'],
  ['Run it yourself', 'Docker, one .env file, your own models.'],
];

const focus = [
  ['Is AI the answer?', 'Feasibility comes before any model. I map where a model creates real value, where plain code wins, and what each AI feature costs per user before anyone builds it.'],
  ['Cost optimization', 'Less compute per answer: dynamic audio chunking, unique-frame analysis and bounded concurrency, with the same quality.'],
  ['Progressive tool calling', 'Agents get tools as a task needs them, not all at once, so prompts stay small and choices stay sharp.'],
  ['Context management', 'What an agent keeps, summarizes and drops as a task grows longer.'],
  ['Memory for MCP clients', 'MCP clients that remember across sessions and tools.'],
];

// Work rows: my own projects, each linking to its own page. Sectra, the agent
// and the research each have a section of their own below, so they are not
// repeated here.
const mine = projects.filter((p) => !['sectra', 'marketing-agent', 'binding-affinity'].includes(p.slug));

// Company work gets its own section, set small: it is a list of what shipped,
// not a showcase. The Veel lines are kept deliberately vague and carry no tech
// tags, because the stack there is not mine to publish.
const company: { t: string; p: string; tags?: string[]; where: string }[] = [
  {
    t: 'Audio authenticity',
    p: 'A service that weighs whether the audio in a video is genuine, giving authenticity checks another angle to judge by.',
    where: 'At Veel',
  },
  {
    t: 'An agent, in fourteen days',
    p: 'An agent taken from an idea to production in two weeks.',
    where: 'At Veel',
  },
  {
    t: 'Auto captions',
    p: 'A captions feature carried all the way to production.',
    where: 'At Veel',
  },
  {
    t: 'AI edits',
    p: 'An editing feature where the model does the work.',
    where: 'At Veel',
  },
  {
    t: 'Skin tone classification',
    p: 'A classifier derived entirely from mathematics rather than a trained model, for accuracy at very low latency.',
    where: 'At Veel',
  },
  {
    t: 'Face verification',
    p: 'A system that checks a creator profile really belongs to the person behind it.',
    where: 'At Veel',
  },
  {
    t: 'A Nepali moderation dataset',
    p: 'Built the Nepali-language dataset behind an in-house content-moderation model.',
    where: 'At Veel',
  },
  {
    t: 'Banking automation',
    p: 'RPA tasks for banks, and a RAG chatbot that answers questions from banking documents.',
    tags: ['RPA', 'RAG', 'LangChain', 'FastAPI'],
    where: 'At Quickfox',
  },
  {
    t: 'QuickStudio nodes',
    p: 'Custom nodes for QuickStudio, an n8n-style automation platform: Google Sheets and other integrations, OAuth sign-in, and automation nodes.',
    tags: ['OAuth', 'Google Sheets API', 'Workflow automation'],
    where: 'At Quickfox',
  },
];

const skills = [
  ['Agents & LLMs', 'LangGraph, LangChain, MCP, Google Gen AI SDK, OpenAI SDK'],
  ['Machine learning', 'PyTorch, Keras, Scikit-learn, SpaCy, NLTK'],
  ['Backend & APIs', 'FastAPI, Strawberry GraphQL, GraphQL Federation, gRPC, Django, Pydantic'],
  ['Data & messaging', 'PostgreSQL, Redis, Amazon S3, Apache Kafka'],
  ['Cloud & DevOps', 'Docker, Kubernetes, Argo CD, GitHub Actions'],
  ['Architecture', 'Hexagonal Architecture, Microservices, Asyncio'],
  ['Tools', 'Git, GitHub'],
  ['Languages', 'Python, C++, C, SQL'],
];

const timeline = [
  { w: 'Aug 2026 – Now', t: 'Jr. AI/ML Engineer', o: 'Veel', p: 'Building AI features that ship to real users.' },
  { w: 'May – Aug 2026', t: 'AI/ML Engineering Intern', o: 'Veel', p: 'Backend services for AI products.' },
  { w: 'Aug – Nov 2025', t: 'Software Engineer Intern', o: 'Quickfox Consulting', p: 'Custom nodes and OAuth for QuickStudio, an n8n-style automation platform. RPA tasks for banks and a banking RAG chatbot.' },
  { w: '2021 – 2025', t: 'B.E. Computer Engineering', o: 'Tribhuvan University', p: 'Final-year research on peptide binding affinity, published in JACEM.' },
];

const navLinks: [string, string, string][] = [
  ['Home', '#top', 'top'],
  ['Sectra', '#sectra', 'sectra'],
  ['Research', '#focus', 'focus'],
  ['Work', '#agent', 'agent work research'],
  ['About', '#about', 'about xp'],
  ['Contact', '#contact', 'contact'],
];
---
<Base
  title="Abiral Bhattarai — AI/ML Engineer"
  description="Abiral Bhattarai is an AI/ML engineer in Kathmandu who turns models and agents into products people use."
  path="/"
  links={navLinks}
  loader
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Abiral Bhattarai',
    jobTitle: 'AI/ML Engineer', url: `${SITE}/`,
    address: { '@type': 'PostalAddress', addressLocality: 'Kathmandu', addressCountry: 'NP' },
    sameAs: [GITHUB, LINKEDIN],
  })} />

  <!-- Hero -->
  <section class="hero" id="top" data-name="Intro">
    <div class="wrap">
      <h1 class="display hero-title">AI <span class="x" aria-hidden="true">×</span><span class="vh">and</span> Product.</h1>
      <div class="hero-row">
        <p class="lede">I'm <strong>Abiral Bhattarai</strong>, an AI/ML engineer in Kathmandu. I turn models and agents into products people use, like <a class="lede-link" href={to('/sectra/')}>Sectra</a>.</p>
        <div class="actions">
          <a class="pill pill-solid" href={`mailto:${EMAIL}`} data-mail aria-haspopup="menu"><Fragment set:html={mailIcon} />Email me</a>
          <a class="pill pill-ink" href={CV} target="_blank" rel="noopener"><Fragment set:html={dlIcon} />View CV</a>
        </div>
      </div>

      <figure class="wave">
        <svg class="w-lg" viewBox={`0 -64 ${HW} ${HH + 64}`} role="img" aria-label="Illustration: a speech waveform where Sectra highlights the words 'the model is only half of the product' and marks them as a clip.">
          <rect class="bracket-fill" x={heroClip[0] * HBW - 4} y="-10" width={(heroClip[1] - heroClip[0] + 1) * HBW + 8} height={HH + 10} rx="10" />
          <path class="bracket" d={`M${heroClip[0] * HBW - 4} ${HH} V-10 h10 M${heroClip[0] * HBW - 4} ${HH} h10 M${(heroClip[1] + 1) * HBW + 4} ${HH} V-10 h-10 M${(heroClip[1] + 1) * HBW + 4} ${HH} h-10`} />
          <text class="tlabel" x={heroClip[0] * HBW + 10} y="-46">CLIP 01 · 00:42 – 01:18</text>
          {heroWords.map((w, i) => {
            const lens = heroWords.map((t) => t.length + 1.6);
            const total = lens.reduce((a, c) => a + c, 0);
            const startX = (heroClip[0] + 1.5) * HBW;
            const width = (heroClip[1] - heroClip[0] - 1) * HBW;
            const before = lens.slice(0, i).reduce((a, c) => a + c, 0);
            const x = startX + (before / total) * width;
            return <text class="word" style={`--w:${i}`} x={x} y="-20">{w}</text>;
          })}
          {hero.map((b, i) => {
            const h = Math.max(4, b.h * (HH - 20));
            const inClip = i >= heroClip[0] && i <= heroClip[1];
            return <rect class={`bar${b.sp ? ' sp' : ''}${inClip ? ' clip' : ''}`} style={`--i:${i}`} x={i * HBW + 1.5} y={HH - h} width={HBW - 3} height={h} rx={(HBW - 3) / 2} />;
          })}
        </svg>
        <svg class="w-sm" viewBox={`0 -40 ${MW} ${MH + 40}`} role="img" aria-label="Illustration: a speech waveform where Sectra marks one passage as a clip.">
          <rect class="bracket-fill" x={mClip[0] * MBW - 3} y="-6" width={(mClip[1] - mClip[0] + 1) * MBW + 6} height={MH + 6} rx="8" />
          <text class="tlabel" x={mClip[0] * MBW + 2} y="-16" style="font-size:13px">CLIP 01 · 00:42 – 01:18</text>
          {mob.map((b, i) => {
            const h = Math.max(3, b.h * (MH - 10));
            const inClip = i >= mClip[0] && i <= mClip[1];
            return <rect class={`bar${b.sp ? ' sp' : ''}${inClip ? ' clip' : ''}`} style={`--i:${i}`} x={i * MBW + 1} y={MH - h} width={MBW - 2} height={h} rx={(MBW - 2) / 2} />;
          })}
        </svg>
        <figcaption>
          <span>Sectra finding a clip in a talk. Illustration.</span>
          <a href="#sectra">See how it works</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Sectra: the clipping demo, then a door to the full page -->
  <section class="sectra" id="sectra" data-tone="stage" data-name="Sectra" aria-labelledby="sectra-title">
    <div class="wrap">
      <div class="sectra-head">
        <h2 class="display sectra-title" id="sectra-title">Sectra<span>.</span></h2>
        <p class="sub">Long videos in. Captioned clips out. Everything runs on your own machine.</p>
        <div class="sectra-meta">
          <a class="pill pill-signal" href={to('/sectra/')}>The full story <Fragment set:html={right} /></a>
          <a class="pill pill-line" href={SECTRA} target="_blank" rel="noopener">View on GitHub <Fragment set:html={arrow} /></a>
          <span class="body">My open-source clipping and narration tool. Local LLM, local speech-to-text, local voices, no upload required.</span>
        </div>
      </div>

      <div class="sectra-overview">
        <div class="ov-text">
          <ul class="ov-list">
            {overview.map(([t, p]) => <li><h3>{t}</h3><p>{p}</p></li>)}
          </ul>
          <p class="ov-tech">yt-dlp · Silero VAD · faster-whisper · Ollama · YuNet · Light-ASD · ffmpeg · Playwright</p>
        </div>
        <SectraLoop />
      </div>

      <a class="sectra-door" href={to('/sectra/')} data-reveal>
        <span class="door-title">There's more to Sectra<span class="door-dot">.</span></span>
        <ul class="door-list">
          {sectraMore.map(([t, p], i) => (
            <li style={`--d:${i}`}><b>{t}</b><span>{p}</span></li>
          ))}
        </ul>
        <span class="door-cta">Read the full story <span class="door-arrow"><Fragment set:html={right} /></span></span>
      </a>
    </div>
  </section>

  <!-- AI x product research -->
  <section class="section" id="focus" data-name="Research" aria-labelledby="focus-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="focus-title">AI <span class="x">×</span> <span class="hook">product</span> research.</h2>
        <p class="sub">The questions I work on: where AI belongs in a product, and how to make it cheap and reliable enough to ship.</p>
      </div>
      <ul class="focus">
        {focus.map(([t, p]) => (
          <li class="fr"><h3>{t}</h3><p>{p}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Marketing agent -->
  <section class="section band-ink" id="agent" data-tone="ink" data-name="Agent" aria-labelledby="agent-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="agent-title">An agent that <span class="hook">asks</span> before it acts.</h2>
        <p class="sub">My open-source marketing agent turns one prompt into a full campaign, and stops twice for your say.</p>
      </div>
      <AgentGraph />
      <div class="agent-foot">
        <ul class="tags">
          <li>LangGraph</li><li>Pydantic</li><li>Tavily</li><li>BeautifulSoup</li><li>Asyncio</li>
        </ul>
        <div class="paper-links">
          <a class="textlink" href={to('/work/marketing-agent/')}>How it works <Fragment set:html={right} /></a>
          <a class="textlink" href={AGENT} target="_blank" rel="noopener">Read the code <Fragment set:html={arrow} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- More work -->
  <section class="section" id="work" data-name="Work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="work-title">More things I've <span class="hook">built</span>.</h2>
      </div>
      <ul class="work">
        {mine.map((w) => (
          <li>
            <a class="row" href={w.href}>
              <h3><span class="num">{num(w.slug)}</span>{w.title}</h3>
              <div>
                <p>{w.line}</p>
                <ul class="tags">{w.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
              <span class="arrow"><Fragment set:html={right} /><span class="vh">Read about {w.title}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Research -->
  <section class="section band-ink" id="research" data-tone="ink" data-name="Paper" aria-labelledby="research-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="research-title"><span class="hook">Published</span> research.</h2>
      </div>
      <div class="paper">
        <div>
          <p class="paper-title">Comparative Study of Deep Learning Models for MHC-II and Epitope Binding Affinity Prediction</p>
          <p class="paper-meta">JACEM · 2025 · doi:10.3126/jacem.v11i1.84250</p>
        </div>
        <div class="paper-side">
          <ul class="models"><li>LSTM</li><li>TCN</li><li>Transformer</li></ul>
          <p class="body">Three architectures compared on regression and classification metrics, with an ensemble built for each architecture on each task.</p>
          <div class="paper-links">
            <a class="textlink" href={to('/work/binding-affinity/')}>About the research <Fragment set:html={right} /></a>
            <a class="textlink" href={PAPER} target="_blank" rel="noopener">Read the paper <Fragment set:html={arrow} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About: skills + timeline -->
  <section class="section" id="about" data-name="About" aria-labelledby="skills-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="skills-title">Tech <span class="hook">specs</span>.</h2>
      </div>
      <dl class="skills">
        {skills.map(([k, v]) => (
          <div class="skill"><dt>{k}</dt><dd>{v.split(', ').map((x, i) => <Fragment>{i > 0 && <span class="sep" aria-hidden="true"> | </span>}<span class="tool">{x}</span>{i < v.split(', ').length - 1 && <span class="vh">, </span>}</Fragment>)}</dd></div>
        ))}
      </dl>

      <div class="section-head" style="margin-top: clamp(6rem, 14vh, 9rem)">
        <h2 class="h2" id="path-title">The path <span class="hook">so far</span>.</h2>
      </div>
      <ol class="timeline" aria-labelledby="path-title">
        {timeline.map((e) => (
          <li class="tl">
            <span class="when">{e.w}</span>
            <div><h3>{e.t}</h3><span class="org">{e.o}</span></div>
            <p>{e.p}</p>
          </li>
        ))}
      </ol>
      <p class="certs"><b>Certifications:</b> Machine Learning Scientist in Python, Deep Learning with PyTorch, and Natural Language Processing in Python (DataCamp); Data Science Foundations (IBM).</p>
    </div>
  </section>

  <!-- Company work: a small-set list, no pages. Deliberately light on detail. -->
  <section class="section band-ink" id="xp" data-tone="ink" data-name="At work" aria-labelledby="xp-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="xp-title">On the <span class="hook">job</span>.</h2>
        <p class="sub">What I've shipped with teams at Veel and Quickfox. Kept brief: the work is theirs, not mine to show.</p>
      </div>
      <ul class="xp">
        {company.map((w) => (
          <li class="xr">
            <span class="xp-where">{w.where}</span>
            <div class="xp-main">
              <h3>{w.t}</h3>
              <p>{w.p}</p>
              {w.tags && <ul class="tags tags-xs">{w.tags.map((t) => <li>{t}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Contact />
</Base>
