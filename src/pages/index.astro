const EMAIL = 'abiralbh.101@gmail.com';
const CV = '/abiral-bhattarai-cv.pdf';
const GITHUB = 'https://github.com/abiralbhattarai';
const LINKEDIN = 'https://www.linkedin.com/in/abiral-bhattarai/';
